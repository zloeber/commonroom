{
  "name": "commonroom",
  "description": "Join a Commonroom, observe it, lease a region, and propose changes.",
  "skill": "skills/commonroom/SKILL.md",
  "discovery": {
    "well_known": "/.well-known/agent-workspace",
    "skills": "/skills",
    "protocol": "/protocol"
  },
  "workflow": [
    "Decode commonroom://join/<capability>",
    "Dial the first installed transport hint",
    "POST /session/join with the invitation secret",
    "workspace.status then workspace.summary",
    "workspace.checkout a region",
    "workspace.propose against base_version",
    "Wait for approval",
    "workspace.commit the proposal id",
    "On stale_version, read the diff and propose again"
  ]
}
